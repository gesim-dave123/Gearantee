@using static ASI.Basecode.Resources.Views.Screen
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#F2F2F3" />
    <title>@ViewData["Title"] · Gearantee</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.css" integrity="sha512-3pIirOrwegjM6erE5gPSwkUzO+3cTjpnV9lexlNZqvupR64iZBnOOTiiLPb9M36zpMScbmUNIcHUqKD47M719g==" crossorigin="anonymous" />
    @RenderSection("Styles", required: false)
</head>
<body class="min-h-screen bg-gray-50 font-sans text-ink antialiased">
    @if (ViewBag.LoginView == true)
    {
        <main class="auth-page min-h-screen">@RenderBody()</main>
    }
    else
    {
        <div class="app-frame min-h-screen lg:flex">
            <button id="sidebar-backdrop" class="fixed inset-0 z-30 hidden bg-black/50 lg:hidden" type="button" aria-label="Close navigation"></button>
            <partial name="_Sidebar" />
            <div class="min-w-0 flex-1">
                <partial name="_Topbar" />
                <main id="main-content" class="mx-auto w-full max-w-[1600px] px-4 py-6 sm:px-6 lg:px-10 lg:py-9" role="main">
                    @if (ViewData["DashboardError"] is string dashboardError)
                    {
                        <div class="mb-7 border-l-4 border-ink bg-white px-4 py-3 text-sm" role="alert">@dashboardError</div>
                    }
                    @RenderBody()
                </main>
                <footer class="px-4 pb-7 text-xs text-gray-500 sm:px-6 lg:px-10">@Copyright</footer>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js" integrity="sha512-VEd+nq25CkR676O+pLBnDW09R7VQX9Mdiij052gVCp5yVH3jGtH70Ho/UUv4mJDsEdTvqRCFZg0NKGiojGnUCw==" crossorigin="anonymous"></script>
    <script>
        if (window.toastr) {
            toastr.options = { positionClass: "toast-top-center", timeOut: 3000, closeButton: true, progressBar: true };
        }
    </script>
    <script src="~/js/app-shell.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
