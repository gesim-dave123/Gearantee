@{
    ViewData["Title"] = "Access denied";
}

<div class="error-card">
    <span class="inline-flex bg-ink px-2.5 py-1 font-sans text-[11px] font-medium tracking-[0.04em] text-white">403</span>
    <h1 class="mt-5 font-display text-3xl font-semibold text-ink">Access denied</h1>
    <p class="mt-2 text-sm leading-6 text-gray-500">You do not have permission to perform this action.</p>
    <a asp-controller="Dashboard" asp-action="Index" class="mt-6 inline-flex text-sm font-semibold text-primary-strong underline underline-offset-4">Return to the dashboard</a>
</div>
