<header class="border-b border-gray-200 bg-white px-4 py-4 sm:px-6 lg:px-10">
    <div class="flex items-center justify-between gap-4">
        <div class="flex min-w-0 items-start gap-3">
            <button id="sidebar-toggle" type="button" class="mt-1 inline-flex size-10 shrink-0 items-center justify-center border border-gray-200 text-gray-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary lg:hidden" aria-label="Open navigation" aria-controls="app-sidebar" aria-expanded="false">
                <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </button>
            <div class="min-w-0">
                <p class="eyebrow">@ViewData["Eyebrow"]</p>
                <h1 class="font-display text-3xl font-semibold leading-tight text-ink sm:text-4xl">@ViewData["Title"]</h1>
            </div>
        </div>
        <div class="hidden items-center gap-4 md:flex">
            @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Users")
            {
                <form asp-controller="Users" asp-action="Index" method="get" class="flex items-center gap-2 border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-gray-500">
                    <label class="sr-only" for="accounts-header-search">Search user accounts</label>
                    <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.4"/><path d="m16 16 4.2 4.2"/></svg>
                    <input id="accounts-header-search" name="search" value="@(Context.Request.Query["search"].ToString())" type="search" placeholder="Search accounts" class="w-44 bg-transparent outline-none placeholder:text-gray-500" />
                </form>
            }
            else
            {
                <label class="sr-only" for="catalog-search">Search equipment</label>
                <div class="flex items-center gap-2 border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-gray-500" title="Available when the equipment catalog is live">
                    <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.4"/><path d="m16 16 4.2 4.2"/></svg>
                    <input id="catalog-search" type="search" placeholder="Search equipment" disabled class="w-44 bg-transparent outline-none placeholder:text-gray-500" />
                </div>
            }
            <p class="whitespace-nowrap text-xs text-gray-500">@ViewData["PageDate"]</p>
        </div>
    </div>
</header>
