@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="error-card">
    <span class="inline-flex bg-ink px-2.5 py-1 font-sans text-[11px] font-medium tracking-[0.04em] text-white">Error</span>
    <h1 class="mt-5 font-display text-3xl font-semibold text-ink">Something went wrong</h1>
    <p class="mt-2 text-sm leading-6 text-gray-500">An error occurred while processing your request. Please try again or contact support.</p>
    @if (Model.ShowRequestId)
    {
        <p class="mt-5 text-xs text-gray-500"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Dashboard" asp-action="Index" class="mt-6 inline-flex text-sm font-semibold text-primary-strong underline underline-offset-4">Return to the dashboard</a>
</div>
